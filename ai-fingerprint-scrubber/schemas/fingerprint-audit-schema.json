{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AIFingerprintAudit",
  "description": "Formal schema for AI code fingerprint and comment clutter audits.",
  "type": "object",
  "required": [
    "version",
    "scanned_at",
    "target_path",
    "total_files_scanned",
    "fingerprint_counts",
    "findings",
    "summary"
  ],
  "properties": {
    "version": {
      "type": "string",
      "enum": ["1.0.0"]
    },
    "scanned_at": {
      "type": "string",
      "format": "date-time"
    },
    "target_path": {
      "type": "string",
      "minLength": 1
    },
    "total_files_scanned": {
      "type": "integer",
      "minimum": 0
    },
    "fingerprint_counts": {
      "type": "object",
      "required": ["emoji_comments", "narrative_comments", "echo_comments", "ai_buzzwords", "divider_banners"],
      "properties": {
        "emoji_comments": { "type": "integer", "minimum": 0 },
        "narrative_comments": { "type": "integer", "minimum": 0 },
        "echo_comments": { "type": "integer", "minimum": 0 },
        "ai_buzzwords": { "type": "integer", "minimum": 0 },
        "divider_banners": { "type": "integer", "minimum": 0 }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/FingerprintFinding"
      }
    },
    "summary": {
      "type": "object",
      "required": ["verdict", "human_code_score", "recommendation"],
      "properties": {
        "verdict": {
          "type": "string",
          "enum": ["CLEAN", "FINGERPRINTS_DETECTED"]
        },
        "human_code_score": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "recommendation": {
          "type": "string",
          "minLength": 5
        }
      }
    }
  },
  "definitions": {
    "FingerprintFinding": {
      "type": "object",
      "required": ["file", "line", "type", "raw_snippet", "suggested_action", "remediation"],
      "properties": {
        "file": { "type": "string", "minLength": 1 },
        "line": { "type": "integer", "minimum": 1 },
        "type": {
          "type": "string",
          "enum": ["emoji_in_comment", "narrative_phrasing", "echo_comment", "ai_buzzword", "divider_banner"]
        },
        "raw_snippet": { "type": "string" },
        "suggested_action": {
          "type": "string",
          "enum": ["DELETE_COMMENT", "REWRITE_CONCISE", "STRIP_EMOJI", "REMOVE_BANNER"]
        },
        "remediation": { "type": "string", "minLength": 5 }
      }
    }
  }
}
