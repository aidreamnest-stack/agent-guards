{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "MobileBillingAndMonetizationAudit",
  "description": "Formal schema for mobile IAP and revenue audits produced by mobile-revenue-and-iap-guard.",
  "type": "object",
  "required": ["version", "target_app", "audited_at", "invariants", "verdict", "summary"],
  "properties": {
    "version": {
      "type": "string",
      "enum": ["1.0.0"]
    },
    "target_app": {
      "type": "string",
      "minLength": 1
    },
    "audited_at": {
      "type": "string",
      "format": "date-time"
    },
    "invariants": {
      "type": "object",
      "required": [
        "google_play_72h_acknowledge",
        "encrypted_entitlement_storage",
        "storekit2_jws_verification",
        "rewarded_ad_ssv_and_debounce",
        "offline_grace_period_resilience",
        "lifetime_ad_free_bypass"
      ],
      "properties": {
        "google_play_72h_acknowledge": { "$ref": "#/definitions/InvariantStatus" },
        "encrypted_entitlement_storage": { "$ref": "#/definitions/InvariantStatus" },
        "storekit2_jws_verification": { "$ref": "#/definitions/InvariantStatus" },
        "rewarded_ad_ssv_and_debounce": { "$ref": "#/definitions/InvariantStatus" },
        "offline_grace_period_resilience": { "$ref": "#/definitions/InvariantStatus" },
        "lifetime_ad_free_bypass": { "$ref": "#/definitions/InvariantStatus" }
      }
    },
    "verdict": {
      "type": "string",
      "enum": ["PASS", "WARN", "FAIL"]
    },
    "summary": {
      "type": "object",
      "required": ["blockers", "warnings", "recommendation"],
      "properties": {
        "blockers": { "type": "integer", "minimum": 0 },
        "warnings": { "type": "integer", "minimum": 0 },
        "recommendation": { "type": "string", "minLength": 5 }
      }
    }
  },
  "definitions": {
    "InvariantStatus": {
      "type": "object",
      "required": ["status", "evidence", "remediation"],
      "properties": {
        "status": {
          "type": "string",
          "enum": ["VERIFIED", "NEEDS_ATTENTION", "VIOLATED", "NOT_APPLICABLE"]
        },
        "evidence": { "type": "string" },
        "remediation": { "type": "string" }
      }
    }
  }
}
