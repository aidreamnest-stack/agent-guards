{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "OrphanDependencyAudit",
  "description": "Formal schema for orphan dependency audit reports generated by orphan-dependency-guard.",
  "type": "object",
  "required": [
    "version",
    "scanned_at",
    "manifest_file",
    "manifest_type",
    "total_declared",
    "retained_count",
    "orphaned_count",
    "orphaned_packages",
    "summary"
  ],
  "properties": {
    "version": {
      "type": "string",
      "enum": ["1.0.0"]
    },
    "scanned_at": {
      "type": "string",
      "format": "date-time"
    },
    "manifest_file": {
      "type": "string",
      "minLength": 1
    },
    "manifest_type": {
      "type": "string",
      "enum": ["npm", "pub.dev", "pypi", "gomod", "cargo"]
    },
    "total_declared": {
      "type": "integer",
      "minimum": 0
    },
    "retained_count": {
      "type": "integer",
      "minimum": 0
    },
    "orphaned_count": {
      "type": "integer",
      "minimum": 0
    },
    "orphaned_packages": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/OrphanPackage"
      }
    },
    "summary": {
      "type": "object",
      "required": ["verdict", "action_required", "recommendation"],
      "properties": {
        "verdict": {
          "type": "string",
          "enum": ["CLEAN", "BLOAT_DETECTED"]
        },
        "action_required": {
          "type": "boolean"
        },
        "recommendation": {
          "type": "string",
          "minLength": 5
        }
      }
    }
  },
  "definitions": {
    "OrphanPackage": {
      "type": "object",
      "required": ["name", "dependency_type", "import_matches", "uninstall_command", "reason"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "dependency_type": {
          "type": "string",
          "enum": ["production", "dev"]
        },
        "import_matches": {
          "type": "integer",
          "enum": [0]
        },
        "estimated_disk_impact_kb": {
          "type": ["number", "null"]
        },
        "uninstall_command": {
          "type": "string",
          "minLength": 5
        },
        "reason": {
          "type": "string",
          "minLength": 5
        }
      }
    }
  }
}
