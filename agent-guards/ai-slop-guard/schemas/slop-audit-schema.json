{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SlopAndRegressionFindings",
  "description": "Formal schema for findings generated by the ai-slop-and-regression-guard skill.",
  "type": "object",
  "required": ["version", "target_repo", "churn_metrics", "findings", "summary"],
  "properties": {
    "version": {
      "type": "string",
      "enum": ["1.0.0"]
    },
    "target_repo": {
      "type": "string",
      "minLength": 1
    },
    "base_ref": {
      "type": "string",
      "default": "origin/main"
    },
    "head_ref": {
      "type": "string",
      "default": "HEAD"
    },
    "churn_metrics": {
      "type": "object",
      "required": ["lines_added", "lines_deleted", "files_changed", "churn_ratio"],
      "properties": {
        "lines_added": { "type": "integer", "minimum": 0 },
        "lines_deleted": { "type": "integer", "minimum": 0 },
        "files_changed": { "type": "integer", "minimum": 0 },
        "churn_ratio": { "type": "number", "minimum": 0 }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/Finding"
      }
    },
    "summary": {
      "type": "object",
      "required": ["verdict", "blockers", "warnings", "recommendation"],
      "properties": {
        "verdict": {
          "type": "string",
          "enum": ["PASS", "WARN", "FAIL"]
        },
        "blockers": { "type": "integer", "minimum": 0 },
        "warnings": { "type": "integer", "minimum": 0 },
        "recommendation": { "type": "string" }
      }
    }
  },
  "definitions": {
    "Finding": {
      "type": "object",
      "required": ["id", "category", "severity", "file", "line", "description", "remediation"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^(INVARIANT|DUPLICATION|SLOP|TEST_REGRESSION)-[0-9]{3}$"
        },
        "category": {
          "type": "string",
          "enum": [
            "invariant_deletion",
            "wheel_reinvention",
            "swallowed_exception",
            "speculative_bloat",
            "redundant_defensive_code",
            "test_loosening"
          ]
        },
        "severity": {
          "type": "string",
          "enum": ["BLOCKER", "HIGH", "MEDIUM", "LOW"]
        },
        "file": {
          "type": "string",
          "minLength": 1
        },
        "line": {
          "type": "integer",
          "minimum": 1
        },
        "snippet": {
          "type": "string"
        },
        "description": {
          "type": "string",
          "minLength": 5
        },
        "remediation": {
          "type": "string",
          "minLength": 5
        }
      }
    }
  }
}
